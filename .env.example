# Credenciais da área restrita (/admin) — copie para .env e personalize.
# Sem .env, o modo dev usa os padrões: admin / rim2026 (NUNCA use em produção).
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
# Segredo usado para assinar o cookie de sessão (use uma string longa e aleatória).
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
