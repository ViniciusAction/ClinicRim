---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { SESSION_COOKIE, authenticate, sessionCookieOptions } from '@/lib/auth';
import { dbConfigError } from '@/lib/db';
import { clientIp, clientUserAgent } from '@/lib/utils/request';

/**
 * Login da área restrita. A própria página processa o POST (sem endpoint
 * separado): valida as credenciais contra o banco, abre a sessão e grava o
 * cookie. O middleware já redireciona quem chega aqui logado.
 *
 * O cookie é SameSite=Lax, o que faz o navegador NÃO enviá-lo em POST vindo de
 * outro site — é o que protege os formulários do painel contra CSRF sem
 * precisar de token por formulário.
 */
export const prerender = false;

const misconfigured = dbConfigError();

let error: string | null = null;
let email = '';

if (Astro.request.method === 'POST' && !misconfigured) {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');

  const result = await authenticate(email, password, {
    ip: clientIp(Astro.request),
    userAgent: clientUserAgent(Astro.request),
  });

  if (result.ok) {
    Astro.cookies.set(SESSION_COOKIE, result.token, sessionCookieOptions);
    // Senha temporária cai direto na troca. O middleware garantiria isso de
    // qualquer forma; aqui só evitamos um redirecionamento a mais.
    return Astro.redirect(result.user.mustChangePassword ? '/admin/conta?trocar=1' : '/admin');
  }

  error = result.message;
}

const fieldClass =
  'block w-full rounded-md border border-ink-200 bg-white px-4 py-2.5 font-sans text-sm text-ink-900 focus:border-azure-400 focus:ring-2 focus:ring-azure-400 focus:outline-none disabled:bg-ink-50 disabled:text-ink-400';
---

<AdminLayout title="Entrar" bare>
  <div class="bg-hero-mesh fixed inset-0 -z-10" aria-hidden="true"></div>

  <div class="mx-auto mt-10 w-full max-w-sm sm:mt-20">
    <div class="border-ink-100 rounded-2xl border bg-white p-8">
      <div class="flex flex-col items-center text-center">
        <span class="bg-azure-600 flex size-12 items-center justify-center rounded-md text-white">
          <svg class="size-6" viewBox="0 0 96 96" fill="none" aria-hidden="true">
            <path
              d="M60 10c-19 0-34 16-34 37 0 16 9 27 21 31 6 2 12 2 17-1-6-4-9-10-9-17 0-8 5-13 11-16 8-4 14-11 14-19C80 15 71 10 60 10Z"
              stroke="currentColor"
              stroke-width="8"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <h1 class="font-display text-ink-900 mt-4 text-xl font-medium">Área da equipe</h1>
        <p class="text-ink-500 mt-1 font-sans text-sm">
          Acesso restrito para publicação de conteúdo no blog.
        </p>
      </div>

      {
        misconfigured && (
          <div
            role="alert"
            class="border-gold-200 bg-gold-50 text-gold-800 mt-6 rounded-2xl border px-4 py-3 font-sans text-sm"
          >
            <p class="font-medium">Painel ainda não configurado</p>
            <p class="mt-1 leading-relaxed">{misconfigured}</p>
          </div>
        )
      }

      {
        error && (
          <p
            role="alert"
            class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 font-sans text-sm leading-relaxed text-red-700"
          >
            {error}
          </p>
        )
      }

      <form method="post" class="mt-6 space-y-4">
        <div>
          <label for="email" class="text-ink-900 mb-1.5 block font-sans text-sm font-medium">
            E-mail
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="username"
            autocapitalize="off"
            spellcheck="false"
            value={email}
            disabled={Boolean(misconfigured)}
            class={fieldClass}
          />
        </div>

        <div>
          <label for="password" class="text-ink-900 mb-1.5 block font-sans text-sm font-medium">
            Senha
          </label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            disabled={Boolean(misconfigured)}
            class={fieldClass}
          />
        </div>

        <button
          type="submit"
          disabled={Boolean(misconfigured)}
          class="bg-azure-600 hover:bg-azure-500 focus-visible:ring-azure-500 inline-flex h-11 w-full items-center justify-center rounded-md font-sans text-sm font-medium text-white transition-all focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-50"
        >
          Entrar no painel
        </button>
      </form>

      <p class="text-ink-400 mt-5 text-center font-sans text-xs leading-relaxed">
        Esqueceu a senha? Peça a outro médico da equipe para redefinir em
        <strong class="text-ink-500">Equipe → Redefinir senha</strong>.
      </p>
    </div>

    <p class="text-ink-400 mt-6 text-center font-sans text-xs">
      <a href="/" class="hover:text-azure-700">← Voltar ao site</a>
    </p>
  </div>
</AdminLayout>
