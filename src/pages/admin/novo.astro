---
import AdminLayout from '@/layouts/AdminLayout.astro';
import PostForm, { type PostFormValues } from '@/components/admin/PostForm.astro';
import { createPost, parsePostForm, validatePostInput } from '@/lib/admin/posts';
import { doctors } from '@/data/doctors';
import { clientIp } from '@/lib/utils/request';

/**
 * Novo artigo. O POST (multipart, por causa da capa) é processado aqui mesmo:
 * valida, grava no Postgres e redireciona ao painel. Em caso de erro, o
 * formulário volta preenchido — o médico não perde o texto que escreveu.
 */
export const prerender = false;

const currentUser = Astro.locals.user!;

let errors: string[] = [];
let values: PostFormValues = {
  title: '',
  description: '',
  specialty: 'Nefrologia',
  authorId: doctors[0]?.id ?? '',
  tags: '',
  coverAlt: '',
  bodyMd: '',
  status: 'published',
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const input = parsePostForm(form);

  // Devolvidos ao formulário se a validação recusar.
  values = {
    title: input.title,
    description: input.description,
    specialty: input.specialty,
    authorId: input.authorId,
    tags: input.tags.join(', '),
    coverAlt: input.coverAlt ?? '',
    bodyMd: input.bodyMd,
    status: input.status,
  };

  errors = validatePostInput(input);

  if (errors.length === 0) {
    try {
      const slug = await createPost(input, {
        userId: currentUser.id,
        ip: clientIp(Astro.request),
      });

      const param = input.status === 'published' ? 'ok' : 'rascunho';
      return Astro.redirect(`/admin?${param}=${encodeURIComponent(slug)}`);
    } catch (error) {
      // Falha de banco ou de upload da capa cai aqui, com o texto preservado.
      errors = [`Não foi possível salvar: ${(error as Error).message}`];
    }
  }
}
---

<AdminLayout title="Novo artigo">
  <div class="mx-auto max-w-3xl">
    <h1 class="font-display text-ink-900 text-2xl font-medium">Novo artigo</h1>
    <p class="text-ink-500 mt-1 font-sans text-sm leading-relaxed">
      Escreva em Markdown. Publicado entra no ar na hora; rascunho fica visível só para a equipe,
      para você conferir como ficou antes de liberar.
    </p>

    <PostForm values={values} errors={errors} submitLabel="Salvar artigo" />
  </div>
</AdminLayout>
