---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { SPECIALTIES, type Specialty } from '@/data/specialties';
import { doctors } from '@/data/doctors';
import { createPostOnDisk, validateNewPost, type NewPostInput } from '@/lib/admin/posts';

/**
 * Editor de novo artigo. O POST (multipart, por causa da capa) é processado
 * aqui mesmo: valida, grava o .md em src/content/blog e redireciona ao painel.
 * Em caso de erro, o formulário volta preenchido.
 */
export const prerender = false;

let errors: string[] = [];
const values = {
  title: '',
  description: '',
  specialty: 'Nefrologia' as Specialty,
  author: doctors[0]?.id ?? '',
  tags: '',
  coverAlt: '',
  body: '',
  draft: false,
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  values.title = String(form.get('title') ?? '');
  values.description = String(form.get('description') ?? '');
  values.specialty = String(form.get('specialty') ?? '') as Specialty;
  values.author = String(form.get('author') ?? '');
  values.tags = String(form.get('tags') ?? '');
  values.coverAlt = String(form.get('coverAlt') ?? '');
  values.body = String(form.get('body') ?? '');
  values.draft = form.get('draft') === 'on';

  const coverEntry = form.get('cover');
  const input: NewPostInput = {
    title: values.title,
    description: values.description,
    specialty: values.specialty,
    author: values.author,
    tags: values.tags
      .split(',')
      .map((t) => t.trim())
      .filter(Boolean),
    body: values.body,
    draft: values.draft,
    cover: coverEntry instanceof File ? coverEntry : null,
    coverAlt: values.coverAlt,
  };

  errors = validateNewPost(input);
  if (errors.length === 0) {
    const slug = await createPostOnDisk(input);
    return Astro.redirect(`/admin?ok=${encodeURIComponent(slug)}`);
  }
}

const inputClass =
  'block w-full rounded-xl border border-ink-200 bg-white px-4 py-2.5 font-sans text-sm text-ink-900 shadow-sm focus:border-azure-400 focus:ring-2 focus:ring-azure-400 focus:outline-none';
const labelClass = 'mb-1.5 block font-sans text-sm font-semibold text-ink-900';
---

<AdminLayout title="Novo artigo">
  <div class="mx-auto max-w-3xl">
    <h1 class="font-display text-2xl font-semibold text-ink-900">Novo artigo</h1>
    <p class="mt-1 font-sans text-sm text-ink-500">
      Escreva em Markdown (títulos com <code>##</code>, negrito com <code>**texto**</code>, listas
      com <code>-</code>). A capa é opcional — sem envio, usamos a arte padrão da especialidade.
    </p>

    {
      errors.length > 0 && (
        <div
          role="alert"
          class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 font-sans text-sm text-red-700"
        >
          <p class="font-bold">Corrija os pontos abaixo:</p>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            {errors.map((e) => (
              <li>{e}</li>
            ))}
          </ul>
        </div>
      )
    }

    <form
      method="post"
      enctype="multipart/form-data"
      class="mt-8 space-y-6 rounded-3xl border border-ink-100 bg-white p-7 shadow-sm sm:p-9"
    >
      <div>
        <label for="title" class={labelClass}>Título *</label>
        <input id="title" name="title" type="text" required value={values.title} class={inputClass} />
      </div>

      <div>
        <label for="description" class={labelClass}>Resumo (SEO e cards do blog) *</label>
        <textarea
          id="description"
          name="description"
          rows="2"
          required
          class={inputClass}>{values.description}</textarea>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="specialty" class={labelClass}>Especialidade *</label>
          <select id="specialty" name="specialty" class={inputClass}>
            {
              SPECIALTIES.map((s) => (
                <option value={s} selected={s === values.specialty}>
                  {s}
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="author" class={labelClass}>Autor *</label>
          <select id="author" name="author" class={inputClass}>
            {
              doctors.map((d) => (
                <option value={d.id} selected={d.id === values.author}>
                  {d.name} — {d.role}
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <div>
        <label for="tags" class={labelClass}>Tags (separadas por vírgula)</label>
        <input
          id="tags"
          name="tags"
          type="text"
          placeholder="ex.: prevenção, rins, hipertensão"
          value={values.tags}
          class={inputClass}
        />
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="cover" class={labelClass}>Capa (JPG, PNG ou WebP — opcional)</label>
          <input
            id="cover"
            name="cover"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            class="block w-full font-sans text-sm text-ink-600 file:mr-3 file:rounded-full file:border-0 file:bg-azure-50 file:px-4 file:py-2 file:font-sans file:text-sm file:font-semibold file:text-azure-700 hover:file:bg-azure-100"
          />
        </div>
        <div>
          <label for="coverAlt" class={labelClass}>Descrição da capa (acessibilidade)</label>
          <input
            id="coverAlt"
            name="coverAlt"
            type="text"
            placeholder="ex.: Médica examinando exame de ultrassom"
            value={values.coverAlt}
            class={inputClass}
          />
        </div>
      </div>

      <div>
        <label for="body" class={labelClass}>Conteúdo do artigo (Markdown) *</label>
        <textarea
          id="body"
          name="body"
          rows="16"
          required
          placeholder={'## Primeiro subtítulo\n\nTexto do artigo...'}
          class={`${inputClass} font-mono leading-relaxed`}>{values.body}</textarea>
      </div>

      <label class="flex items-center gap-3 font-sans text-sm text-ink-700">
        <input
          type="checkbox"
          name="draft"
          checked={values.draft}
          class="size-4 rounded border-ink-300 text-azure-600 focus:ring-azure-400"
        />
        Salvar como rascunho (não aparece no blog)
      </label>

      <div class="flex items-center gap-4 border-t border-ink-100 pt-6">
        <button
          type="submit"
          class="inline-flex h-12 items-center justify-center rounded-full bg-azure-600 px-8 font-sans text-sm font-semibold text-white shadow-sm transition-all hover:bg-azure-500 focus-visible:ring-2 focus-visible:ring-azure-500 focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          Publicar artigo
        </button>
        <a href="/admin" class="font-sans text-sm font-semibold text-ink-500 hover:text-ink-800">
          Cancelar
        </a>
      </div>
    </form>
  </div>
</AdminLayout>
