---
import AdminLayout from '@/layouts/AdminLayout.astro';
import {
  LOGIN_RATE_LIMIT,
  changeOwnPassword,
  listActiveSessions,
  revokeAllForUser,
  revokeSession,
  type ActiveSession,
} from '@/lib/auth';
import { clientIp } from '@/lib/utils/request';

/**
 * Minha conta — troca da própria senha e gestão das próprias sessões.
 *
 * É a única rota (junto do logout) liberada para quem está com senha
 * temporária: o middleware manda todo mundo para cá até a troca acontecer.
 */
export const prerender = false;

// O middleware garante a sessão em toda rota /admin exceto o login.
const user = Astro.locals.user!;
const ip = clientIp(Astro.request);

const forcedChange = Astro.url.searchParams.has('trocar') || user.mustChangePassword;

let errors: string[] = [];
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'change-password') {
    const current = String(form.get('currentPassword') ?? '');
    const next = String(form.get('newPassword') ?? '');
    const confirmation = String(form.get('confirmPassword') ?? '');

    if (next !== confirmation) {
      errors = ['A confirmação não confere com a nova senha.'];
    } else {
      const result = await changeOwnPassword(user.id, current, next, {
        ip,
        keepSessionId: user.sessionId,
      });

      if (result.ok) {
        // Sai daqui por redirect para que a página recarregue já sem o
        // bloqueio de senha temporária.
        return Astro.redirect('/admin?senha=ok');
      }
      errors = result.errors;
    }
  }

  if (action === 'revoke-session') {
    const sessionId = String(form.get('sessionId') ?? '');
    if (sessionId === user.sessionId) {
      errors = ['Para encerrar a sessão atual, use o botão "Sair".'];
    } else {
      await revokeSession(sessionId);
      notice = 'Sessão encerrada.';
    }
  }

  if (action === 'revoke-others') {
    await revokeAllForUser(user.id, user.sessionId);
    notice = 'Todos os outros dispositivos foram desconectados.';
  }
}

let sessions: ActiveSession[] = [];
let sessionsError: string | null = null;
try {
  sessions = await listActiveSessions(user.id, user.sessionId);
} catch (error) {
  sessionsError = (error as Error).message;
}

/** "Chrome em Windows" a partir do user-agent — sem biblioteca, só o suficiente. */
function describeDevice(userAgent: string | null): string {
  if (!userAgent) return 'Dispositivo desconhecido';

  const browser =
    /Edg\//.test(userAgent) ? 'Edge'
    : /OPR\//.test(userAgent) ? 'Opera'
    : /Chrome\//.test(userAgent) ? 'Chrome'
    : /Safari\//.test(userAgent) ? 'Safari'
    : /Firefox\//.test(userAgent) ? 'Firefox'
    : 'Navegador';

  const system =
    /iPhone|iPad/.test(userAgent) ? 'iOS'
    : /Android/.test(userAgent) ? 'Android'
    : /Mac OS X/.test(userAgent) ? 'macOS'
    : /Windows/.test(userAgent) ? 'Windows'
    : /Linux/.test(userAgent) ? 'Linux'
    : 'sistema desconhecido';

  return `${browser} em ${system}`;
}

const dateTime = new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short', timeStyle: 'short' });

const fieldClass =
  'block w-full rounded-md border border-ink-200 bg-white px-4 py-2.5 font-sans text-sm text-ink-900 focus:border-azure-400 focus:ring-2 focus:ring-azure-400 focus:outline-none';
const labelClass = 'mb-1.5 block font-sans text-sm font-medium text-ink-900';
---

<AdminLayout title="Minha conta">
  <div class="mx-auto max-w-2xl">
    <h1 class="font-display text-ink-900 text-2xl font-medium">Minha conta</h1>
    <p class="text-ink-500 mt-1 font-sans text-sm">
      {user.name} · <span class="text-ink-400">{user.email}</span>
    </p>

    {
      forcedChange && (
        <div
          role="alert"
          class="border-gold-200 bg-gold-50 text-gold-800 mt-6 rounded-2xl border px-5 py-4 font-sans text-sm"
        >
          <p class="font-medium">Defina a sua senha para continuar</p>
          <p class="mt-1 leading-relaxed">
            Você está usando uma senha temporária, que outra pessoa conhece. O restante do painel
            fica bloqueado até você escolher uma senha própria.
          </p>
        </div>
      )
    }

    {
      notice && (
        <p
          role="status"
          class="border-azure-200 bg-azure-50 text-azure-800 mt-6 rounded-2xl border px-4 py-3 font-sans text-sm"
        >
          {notice}
        </p>
      )
    }

    {
      errors.length > 0 && (
        <div
          role="alert"
          class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 font-sans text-sm text-red-700"
        >
          <ul class="list-disc space-y-1 pl-5">
            {errors.map((message) => (
              <li>{message}</li>
            ))}
          </ul>
        </div>
      )
    }

    {/* ── Troca de senha ─────────────────────────────────────────────── */}
    <section class="border-ink-100 mt-8 rounded-2xl border bg-white p-8">
      <h2 class="font-display text-ink-900 text-lg font-medium">Trocar senha</h2>
      <p class="text-ink-500 mt-1 font-sans text-sm leading-relaxed">
        Mínimo de 12 caracteres. Uma frase que só você saiba — como
        <em>“meu gato dorme na janela”</em> — é mais segura e mais fácil de lembrar do que
        algo curto com símbolos.
      </p>

      <form method="post" class="mt-6 space-y-5">
        <input type="hidden" name="action" value="change-password" />

        <div>
          <label for="currentPassword" class={labelClass}>Senha atual *</label>
          <input
            id="currentPassword"
            name="currentPassword"
            type="password"
            required
            autocomplete="current-password"
            class={fieldClass}
          />
        </div>

        <div>
          <label for="newPassword" class={labelClass}>Nova senha *</label>
          <input
            id="newPassword"
            name="newPassword"
            type="password"
            required
            minlength="12"
            autocomplete="new-password"
            class={fieldClass}
          />
        </div>

        <div>
          <label for="confirmPassword" class={labelClass}>Confirme a nova senha *</label>
          <input
            id="confirmPassword"
            name="confirmPassword"
            type="password"
            required
            minlength="12"
            autocomplete="new-password"
            class={fieldClass}
          />
        </div>

        <button
          type="submit"
          class="bg-azure-600 hover:bg-azure-500 inline-flex h-11 items-center rounded-md px-7 font-sans text-sm font-medium text-white transition-all"
        >
          Salvar nova senha
        </button>

        <p class="text-ink-400 font-sans text-xs leading-relaxed">
          Ao trocar a senha, os outros dispositivos conectados a esta conta são desconectados
          automaticamente.
        </p>
      </form>
    </section>

    {/* ── Sessões ────────────────────────────────────────────────────── */}
    <section class="border-ink-100 mt-6 rounded-2xl border bg-white p-8">
      <h2 class="font-display text-ink-900 text-lg font-medium">Dispositivos conectados</h2>
      <p class="text-ink-500 mt-1 font-sans text-sm leading-relaxed">
        Se você não reconhece um acesso, encerre-o e troque a sua senha.
      </p>

      {
        sessionsError ? (
          <p class="mt-4 font-sans text-sm text-red-700">{sessionsError}</p>
        ) : (
          <ul class="divide-ink-100 mt-5 divide-y">
            {sessions.map((session) => (
              <li class="flex flex-wrap items-center gap-x-4 gap-y-2 py-3">
                <div class="min-w-0 flex-1">
                  <p class="text-ink-900 font-sans text-sm font-medium">
                    {describeDevice(session.userAgent)}
                    {session.current && (
                      <span class="bg-azure-50 text-azure-700 ml-2 rounded-md px-2 py-0.5 text-[10px] font-medium tracking-[0.12em] uppercase">
                        este
                      </span>
                    )}
                  </p>
                  <p class="text-ink-400 mt-0.5 font-sans text-xs">
                    {session.ip ?? 'IP desconhecido'} · desde{' '}
                    {dateTime.format(new Date(session.createdAt))}
                  </p>
                </div>

                {!session.current && (
                  <form method="post">
                    <input type="hidden" name="action" value="revoke-session" />
                    <input type="hidden" name="sessionId" value={session.id} />
                    <button
                      type="submit"
                      class="rounded-md border border-red-200 px-3.5 py-1.5 font-sans text-xs font-medium text-red-600 transition-colors hover:bg-red-50"
                    >
                      Encerrar
                    </button>
                  </form>
                )}
              </li>
            ))}
          </ul>
        )
      }

      {
        sessions.length > 1 && (
          <form method="post" class="border-ink-100 mt-4 border-t pt-4">
            <input type="hidden" name="action" value="revoke-others" />
            <button
              type="submit"
              class="border-ink-200 text-ink-700 hover:border-azure-300 hover:bg-azure-50 rounded-md border px-4 py-2 font-sans text-sm font-medium transition-colors"
            >
              Desconectar todos os outros dispositivos
            </button>
          </form>
        )
      }
    </section>

    <p class="text-ink-400 mt-6 font-sans text-xs leading-relaxed">
      ℹ️ Por segurança, {LOGIN_RATE_LIMIT.maxPerEmail} tentativas de senha erradas bloqueiam o
      login desta conta por {LOGIN_RATE_LIMIT.windowMinutes} minutos.
    </p>
  </div>
</AdminLayout>
