---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { listPosts, deletePost, type AdminPostSummary } from '@/lib/admin/posts';
import { getDoctorById } from '@/data/doctors';
import { clientIp } from '@/lib/utils/request';

/**
 * Painel — lista os artigos do blog, com ações de editar e excluir.
 * Criação fica em /admin/novo, edição em /admin/editar/[slug].
 *
 * Rascunhos aparecem aqui junto dos publicados, marcados. É o painel: quem
 * escreve precisa ver o que ainda não foi ao ar.
 */
export const prerender = false;

const currentUser = Astro.locals.user!;
const ip = clientIp(Astro.request);

let notice: { kind: 'success' | 'error'; text: string } | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  if (form.get('action') === 'delete') {
    const slug = String(form.get('slug') ?? '');
    try {
      notice = (await deletePost(slug, { userId: currentUser.id, ip }))
        ? { kind: 'success', text: `Artigo "${slug}" excluído. Já saiu do blog.` }
        : { kind: 'error', text: 'Não foi possível excluir: artigo não encontrado.' };
    } catch (error) {
      notice = { kind: 'error', text: `Falha ao excluir: ${(error as Error).message}` };
    }
  }
}

/* Mensagens vindas de outra página, por querystring. */
const publishedSlug = Astro.url.searchParams.get('ok');
const updatedSlug = Astro.url.searchParams.get('editado');
const draftSlug = Astro.url.searchParams.get('rascunho');

if (publishedSlug) {
  notice = {
    kind: 'success',
    text: `Artigo publicado e já no ar em /blog/${publishedSlug}/`,
  };
} else if (updatedSlug) {
  notice = { kind: 'success', text: `Alterações salvas. Já valendo em /blog/${updatedSlug}/` };
} else if (draftSlug) {
  notice = {
    kind: 'success',
    text: `Rascunho salvo. Só você e a equipe conseguem vê-lo em /blog/${draftSlug}/`,
  };
} else if (Astro.url.searchParams.has('senha')) {
  notice = { kind: 'success', text: 'Senha alterada. Os outros dispositivos foram desconectados.' };
} else if (Astro.url.searchParams.get('erro') === 'nao-encontrado') {
  notice = {
    kind: 'error',
    text: 'Esse artigo não existe mais — provavelmente foi excluído.',
  };
}

let posts: AdminPostSummary[] = [];
let loadError: string | null = null;
try {
  posts = await listPosts();
} catch (error) {
  loadError = `Não foi possível ler os artigos: ${(error as Error).message}`;
}

const published = posts.filter((post) => post.status === 'published');
const drafts = posts.filter((post) => post.status !== 'published');

const dateFormat = new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short' });
const actionClass =
  'rounded-md border border-ink-200 px-3.5 py-1.5 font-sans text-xs font-medium text-ink-700 transition-colors hover:border-azure-300 hover:bg-azure-50';
---

<AdminLayout title="Publicações">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-ink-900 text-2xl font-medium">Publicações</h1>
      <p class="text-ink-500 mt-1 font-sans text-sm">
        {published.length} publicado{published.length === 1 ? '' : 's'}
        {drafts.length > 0 && ` · ${drafts.length} rascunho${drafts.length === 1 ? '' : 's'}`}
      </p>
    </div>
    <a
      href="/admin/novo"
      class="bg-azure-600 hover:bg-azure-500 inline-flex h-11 items-center gap-2 rounded-md px-6 font-sans text-sm font-medium text-white transition-all"
    >
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M12 5v14M5 12h14"></path>
      </svg>
      Novo artigo
    </a>
  </div>

  {
    loadError && (
      <p
        role="alert"
        class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 font-sans text-sm text-red-700"
      >
        {loadError}
      </p>
    )
  }

  {
    notice && (
      <p
        role="status"
        class:list={[
          'mt-6 rounded-2xl border px-4 py-3 font-sans text-sm',
          notice.kind === 'success'
            ? 'border-azure-200 bg-azure-50 text-azure-800'
            : 'border-red-200 bg-red-50 text-red-700',
        ]}
      >
        {notice.text}
      </p>
    )
  }

  <div class="border-ink-100 mt-8 overflow-hidden rounded-2xl border bg-white">
    {
      posts.length === 0 && !loadError ? (
        <p class="text-ink-500 p-10 text-center font-sans text-sm">
          Nenhum artigo ainda. Clique em <strong>Novo artigo</strong> para publicar o primeiro.
        </p>
      ) : (
        <ul class="divide-ink-100 divide-y">
          {posts.map((post) => {
            const author = getDoctorById(post.authorId);
            const isDraft = post.status !== 'published';

            return (
              <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-6 py-4">
                <div class="min-w-0 flex-1">
                  <p class="text-ink-900 font-sans text-sm font-medium">
                    {post.title}
                    {isDraft && (
                      <span class="bg-gold-100 text-gold-700 ml-2 rounded-md px-2 py-0.5 text-[10px] font-medium tracking-[0.12em] uppercase">
                        rascunho
                      </span>
                    )}
                  </p>
                  <p class="text-ink-400 mt-0.5 font-sans text-xs">
                    {post.specialty}
                    {author && ` · ${author.name}`}
                    {' · '}
                    {post.publishedAt
                      ? `publicado em ${dateFormat.format(post.publishedAt)}`
                      : `editado em ${dateFormat.format(post.updatedAt)}`}
                  </p>
                </div>

                <a href={`/blog/${post.slug}/`} target="_blank" rel="noopener" class={actionClass}>
                  {isDraft ? 'Pré-visualizar ↗' : 'Ver ↗'}
                </a>

                <a
                  href={`/admin/editar/${post.slug}`}
                  class="border-azure-300 text-azure-700 hover:bg-azure-50 rounded-md border px-3.5 py-1.5 font-sans text-xs font-medium transition-colors"
                >
                  Editar
                </a>

                <form
                  method="post"
                  onsubmit={`return confirm('Excluir o artigo “${post.title.replaceAll("'", '’').replaceAll('"', '”')}”? Esta ação não pode ser desfeita.');`}
                >
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="slug" value={post.slug} />
                  <button
                    type="submit"
                    class="rounded-md border border-red-200 px-3.5 py-1.5 font-sans text-xs font-medium text-red-600 transition-colors hover:bg-red-50"
                  >
                    Excluir
                  </button>
                </form>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>

  <p class="text-ink-400 mt-6 font-sans text-xs leading-relaxed">
    ℹ️ Os artigos ficam no banco de dados da clínica. Publicar, editar e excluir valem
    <strong>na hora</strong> — não há build nem espera. Toda alteração num artigo publicado guarda a
    versão anterior no histórico, então nada se perde por engano.
  </p>
</AdminLayout>
