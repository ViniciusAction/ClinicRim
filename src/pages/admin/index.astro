---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { listPostsOnDisk, deletePostOnDisk } from '@/lib/admin/posts';

/**
 * Painel — lista de publicações do blog (lidas direto do disco) com ação de
 * exclusão. Criação fica em /admin/novo.
 */
export const prerender = false;

let notice: { kind: 'success' | 'error'; text: string } | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('action') === 'delete') {
    const slug = String(form.get('slug') ?? '');
    notice = deletePostOnDisk(slug)
      ? { kind: 'success', text: `Artigo "${slug}" excluído.` }
      : { kind: 'error', text: 'Não foi possível excluir este artigo.' };
  }
}

const created = Astro.url.searchParams.get('ok');
if (created) {
  notice = { kind: 'success', text: `Artigo publicado! Veja em /blog/${created}/` };
}

const posts = listPostsOnDisk();
---

<AdminLayout title="Publicações">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-2xl font-semibold text-ink-900">Publicações</h1>
      <p class="mt-1 font-sans text-sm text-ink-500">
        {posts.length} artigo{posts.length === 1 ? '' : 's'} no blog da clínica.
      </p>
    </div>
    <a
      href="/admin/novo"
      class="inline-flex h-11 items-center gap-2 rounded-full bg-azure-600 px-6 font-sans text-sm font-semibold text-white shadow-sm transition-all hover:bg-azure-500"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M12 5v14M5 12h14" />
      </svg>
      Novo artigo
    </a>
  </div>

  {
    notice && (
      <p
        role="status"
        class:list={[
          'mt-6 rounded-2xl border px-4 py-3 font-sans text-sm',
          notice.kind === 'success'
            ? 'border-azure-200 bg-azure-50 text-azure-800'
            : 'border-red-200 bg-red-50 text-red-700',
        ]}
      >
        {notice.text}
      </p>
    )
  }

  <div class="mt-8 overflow-hidden rounded-3xl border border-ink-100 bg-white shadow-sm">
    {
      posts.length === 0 ? (
        <p class="p-10 text-center font-sans text-sm text-ink-500">
          Nenhum artigo ainda. Clique em <strong>Novo artigo</strong> para publicar o primeiro.
        </p>
      ) : (
        <ul class="divide-y divide-ink-100">
          {posts.map((post) => (
            <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-6 py-4">
              <div class="min-w-0 flex-1">
                <p class="truncate font-sans text-sm font-bold text-ink-900">
                  {post.title}
                  {post.draft && (
                    <span class="ml-2 rounded-full bg-gold-100 px-2 py-0.5 text-[10px] font-bold tracking-wide text-gold-700 uppercase">
                      rascunho
                    </span>
                  )}
                </p>
                <p class="mt-0.5 font-sans text-xs text-ink-400">
                  {post.specialty} · {post.pubDate} · <code class="text-ink-500">{post.fileName}</code>
                </p>
              </div>

              <a
                href={`/blog/${post.slug}/`}
                target="_blank"
                rel="noopener"
                class="rounded-full border border-ink-200 px-3.5 py-1.5 font-sans text-xs font-semibold text-ink-700 transition-colors hover:border-azure-300 hover:bg-azure-50"
              >
                Ver ↗
              </a>

              <form
                method="post"
                onsubmit={`return confirm('Excluir o artigo “${post.title.replaceAll("'", '’').replaceAll('"', '”')}”? Esta ação não pode ser desfeita.');`}
              >
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="slug" value={post.slug} />
                <button
                  type="submit"
                  class="rounded-full border border-red-200 px-3.5 py-1.5 font-sans text-xs font-semibold text-red-600 transition-colors hover:bg-red-50"
                >
                  Excluir
                </button>
              </form>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <p class="mt-6 font-sans text-xs leading-relaxed text-ink-400">
    ℹ️ Em desenvolvimento (<code>npm run dev</code>) o artigo aparece no blog imediatamente. Em
    produção, o blog é estático — rode <code>npm run build</code> após publicar para regenerar as
    páginas.
  </p>
</AdminLayout>
