---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import PostCard from '@/components/ui/PostCard.astro';
import { getPublishedPostsBySpecialty } from '@/lib/blog';
import { specialtyFromSlug } from '@/data/specialties';

/**
 * Uma página por especialidade — existe sempre, mesmo sem posts ainda, boa para
 * SEO de conteúdo médico segmentado (Nefrologia / Endocrinologia / Urologia).
 *
 * Sob demanda porque os artigos vêm do Postgres. As três especialidades
 * continuam fixas em src/data/specialties.ts; o que mudou é só de onde vêm os
 * artigos de cada uma.
 */
export const prerender = false;

const { specialty: slug } = Astro.params;
const specialty = specialtyFromSlug(slug ?? '');

/**
 * Slug desconhecido é 404. Antes o `getStaticPaths` garantia que só as três
 * existissem e o `!` no fim era seguro; sob demanda, qualquer string chega aqui
 * e sem esta guarda `/blog/especialidade/qualquer-coisa` renderizaria uma
 * página vazia com 200 — lixo para o Google indexar.
 */
if (!specialty) return Astro.rewrite('/404');

const posts = await getPublishedPostsBySpecialty(specialty);

Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300');
---

<BaseLayout
  title={`Blog de ${specialty} — Clínica RIM`}
  description={`Artigos sobre ${specialty} produzidos pela equipe da Clínica RIM.`}
>
  <Container as="section" class="py-16 sm:py-20">
    <SectionHeading eyebrow="Blog" title={`Conteúdo de ${specialty}`} as="h1" />

    {
      posts.length === 0 ? (
        <p class="mx-auto mt-12 max-w-xl text-center font-sans text-azure-100">
          Em breve, novos artigos sobre {specialty}.
        </p>
      ) : (
        <ul class="mx-auto mt-12 grid max-w-6xl gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      )
    }
  </Container>
</BaseLayout>
