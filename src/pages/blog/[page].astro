---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import PostCard from '@/components/ui/PostCard.astro';
import { getPublishedPosts, paginatePosts } from '@/lib/blog';

/**
 * Páginas 2+ da listagem (a página 1 vive em /blog, estática). Gerada apenas
 * quando há posts suficientes para mais de uma página.
 */
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const { totalPages } = paginatePosts(posts, 1);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const { page } = Astro.params;
const posts = await getPublishedPosts();
const { items, currentPage, totalPages } = paginatePosts(posts, Number(page));
---

<BaseLayout
  title={`Blog — Página ${currentPage} — Clínica RIM`}
  description="Conteúdo médico sobre Nefrologia, Endocrinologia e Urologia produzido pela equipe da Clínica RIM."
  noindex
>
  <Container as="section" class="py-16 sm:py-20">
    <SectionHeading eyebrow="Blog" title="Conteúdo da Clínica RIM" as="h1" />

    <ul class="mx-auto mt-12 grid max-w-6xl gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))
      }
    </ul>

    <nav class="mt-12 flex justify-center gap-3" aria-label="Paginação do blog">
      <a
        href={currentPage - 1 === 1 ? '/blog/' : `/blog/${currentPage - 1}/`}
        class="rounded-md border border-white/15 px-5 py-2.5 font-sans text-sm font-medium text-white hover:bg-white/5"
      >
        Página anterior
      </a>
      {
        currentPage < totalPages && (
          <a
            href={`/blog/${currentPage + 1}/`}
            class="rounded-md border border-white/15 px-5 py-2.5 font-sans text-sm font-medium text-white hover:bg-white/5"
          >
            Próxima página
          </a>
        )
      }
    </nav>
  </Container>
</BaseLayout>
