---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import PostCard from '@/components/ui/PostCard.astro';
import { getPublishedPosts, paginatePosts } from '@/lib/blog';

/**
 * Página 1 da listagem do blog — SEMPRE existe, mesmo sem posts publicados,
 * mostrando um estado vazio em vez de 404. Páginas 2+ ficam em /blog/[page].
 *
 * Renderizada sob demanda porque os artigos agora vivem no Postgres: publicar
 * é um INSERT, e a listagem precisa refletir isso na hora, sem rebuild.
 */
export const prerender = false;

const posts = await getPublishedPosts();
const { items, totalPages } = paginatePosts(posts, 1);

/**
 * Cache de borda curto. Não é otimização de fachada: enquanto esta resposta
 * está fresca, uma rajada de visitas não vira uma rajada de consultas ao
 * Postgres, e `stale-while-revalidate` mantém a página servindo mesmo se o
 * banco engasgar por alguns segundos. Vale para todas as páginas do blog.
 */
Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300');
---

<BaseLayout
  title="Blog — Clínica RIM"
  description="Conteúdo médico sobre Nefrologia, Endocrinologia e Urologia produzido pela equipe da Clínica RIM."
>
  <Container as="section" class="py-16 sm:py-20">
    <SectionHeading eyebrow="Blog" title="Conteúdo da Clínica RIM" as="h1" />

    {
      items.length === 0 ? (
        <p class="mx-auto mt-12 max-w-xl text-center font-sans text-azure-100">
          Em breve, novos artigos sobre Nefrologia, Endocrinologia e Urologia.
        </p>
      ) : (
        <ul class="mx-auto mt-12 grid max-w-6xl gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      )
    }

    {
      totalPages > 1 && (
        <nav class="mt-12 flex justify-center" aria-label="Paginação do blog">
          <a
            href="/blog/pagina/2/"
            class="rounded-md border border-white/15 px-5 py-2.5 font-sans text-sm font-medium text-white hover:bg-white/5"
          >
            Próxima página
          </a>
        </nav>
      )
    }
  </Container>
</BaseLayout>
