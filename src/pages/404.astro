---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
---

<BaseLayout
  title="Página não encontrada — Clínica RIM"
  description="Página não encontrada."
  noindex
>
  <Container
    as="section"
    class="flex min-h-[60vh] flex-col items-center justify-center text-center"
  >
    <p class="font-sans text-sm font-bold tracking-[0.2em] text-azure-600 uppercase">
      Erro 404
    </p>
    <h1 class="mt-3 font-display text-4xl font-semibold text-ink-900 sm:text-5xl">
      Página não encontrada
    </h1>
    <p class="mt-4 max-w-md font-sans text-ink-600">
      O conteúdo que você procura não existe ou foi movido.
    </p>
    <Button href="/" class="mt-8">Voltar para a página inicial</Button>
  </Container>
</BaseLayout>
