---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import PostCover from '@/components/ui/PostCover.astro';
import type { BlogPost } from '@/lib/blog';
import { getDoctorById } from '@/data/doctors';

interface Props {
  post: BlogPost;
  /**
   * `true` quando a página está sendo vista por alguém do painel via
   * pré-visualização de rascunho. Só controla a tarja de aviso no topo.
   */
  preview?: boolean;
}

const { post, preview = false } = Astro.props;
const { title, description, coverUrl, coverAlt, tags, specialty, status } = post;

const author = getDoctorById(post.authorId);

/** Rascunho não tem data de publicação; nesse caso a data exibida é a da edição. */
const date = post.publishedAt ?? post.updatedAt;
const formattedDate = date.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: post.updatedAt.toISOString(),
  author: author ? { '@type': 'Person', name: author.name } : undefined,
  about: specialty,
};
---

<BaseLayout
  title={`${title} — Blog Clínica RIM`}
  description={description}
  type="article"
  noindex={status !== 'published'}
>
  {
    preview && (
      <Container class="max-w-3xl pt-8">
        <p
          role="status"
          class="border-gold-300 bg-gold-100 text-gold-700 rounded-2xl border px-5 py-4 font-sans text-sm leading-relaxed"
        >
          <strong>Pré-visualização de rascunho.</strong> Esta página só é visível para quem está
          logado no painel e não aparece na listagem do blog, no RSS nem no sitemap. Para publicar,
          volte ao painel e edite o artigo.
        </p>
      </Container>
    )
  }

  <article>
    <Container as="header" class="max-w-3xl pt-12">
      <p class="text-azure-300 font-sans text-sm font-medium tracking-[0.12em] uppercase">
        {specialty}
      </p>
      <h1
        class="font-display mt-3 text-4xl leading-none font-medium tracking-tight text-balance text-white sm:text-5xl"
      >
        {title}
      </h1>
      <div class="text-ink-300 mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-sans text-sm">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {author && <span>· {author.name}</span>}
      </div>
    </Container>

    <Container class="mt-8 max-w-4xl">
      <PostCover
        coverUrl={coverUrl}
        specialty={specialty}
        alt={coverAlt}
        width={1200}
        height={675}
        class="aspect-[16/9] w-full rounded-2xl object-cover"
        priority
      />
    </Container>

    <Container
      class="prose prose-invert prose-headings:font-display prose-headings:font-medium prose-headings:text-white prose-p:text-azure-100 prose-a:text-azure-300 prose-strong:text-white mt-10 max-w-3xl font-sans"
    >
      <slot />
    </Container>

    {
      tags.length > 0 && (
        <Container class="mt-10 max-w-3xl">
          <ul class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="bg-azure-500/10 text-azure-300 rounded-md px-3 py-1 font-sans text-xs font-medium">
                #{tag}
              </li>
            ))}
          </ul>
        </Container>
      )
    }
  </article>

  <JsonLd schema={articleSchema} />
</BaseLayout>
