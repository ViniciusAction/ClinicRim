---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import type { BlogPost } from '@/lib/blog';
import { getDoctorById } from '@/data/doctors';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, cover, coverAlt, tags, specialty } = post.data;

const author = getDoctorById(post.data.author);
const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: author ? { '@type': 'Person', name: author.name } : undefined,
  about: specialty,
};
---

<BaseLayout title={`${title} — Blog Clínica RIM`} description={description} type="article">
  <article>
    <Container as="header" class="max-w-3xl pt-12">
      <p class="font-sans text-sm font-medium tracking-[0.12em] text-azure-300 uppercase">
        {specialty}
      </p>
      <h1 class="mt-3 text-balance font-display text-4xl leading-none font-medium tracking-tight text-white sm:text-5xl">
        {title}
      </h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-sans text-sm text-ink-300">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {author && <span>· {author.name}</span>}
      </div>
    </Container>

    <Container class="mt-8 max-w-4xl">
      <Image
        src={cover}
        alt={coverAlt}
        width={1200}
        height={675}
        class="aspect-[16/9] w-full rounded-2xl object-cover"
        priority
      />
    </Container>

    <Container class="prose prose-invert prose-headings:font-display prose-headings:font-medium prose-headings:text-white prose-p:text-azure-100 prose-a:text-azure-300 prose-strong:text-white mt-10 max-w-3xl font-sans">
      <slot />
    </Container>

    {
      tags.length > 0 && (
        <Container class="mt-10 max-w-3xl">
          <ul class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="rounded-md bg-azure-500/10 px-3 py-1 font-sans text-xs font-medium text-azure-300">
                #{tag}
              </li>
            ))}
          </ul>
        </Container>
      )
    }
  </article>

  <JsonLd schema={articleSchema} />
</BaseLayout>
