---
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ContactForm from '@/components/react/ContactForm.tsx';
import { clinic } from '@/data/clinic';
import { buildWhatsappUrl } from '@/lib/utils/whatsapp';

/**
 * Seção 8 — Formulário de Atendimento.
 * Layout split: info/CTA WhatsApp à esquerda, formulário à direita.
 * Fundo navy (bg-ink-900) — seção âncora de conversão, deve ter peso visual.
 * ⚠️ Título/intro são VERBATIM.
 */
const waUrl = buildWhatsappUrl('Olá! Gostaria de agendar uma consulta na Clínica Rim.');
---

<Section id="contato" labelledby="contato-heading" class="bg-ink-950">
  <Container class="grid items-start gap-14 lg:grid-cols-[1fr_1.1fr]">

    {/* ── Coluna esquerda: info e CTA WhatsApp ── */}
    <div data-reveal="fade-right" class="pt-1">
      <SectionHeading
        id="contato-heading"
        eyebrow="Formulário de Atendimento"
        title="Entre em Contato Conosco"
        intro="Se preferir que nossa equipe entre em contato diretamente com você para alinhar detalhes ou agendamentos, preencha os campos ao lado de acordo com o seu perfil:"
        align="left"
        inverted
        class="max-w-none"
      />

      {/* Botão WhatsApp — aparece só se o número estiver configurado */}
      {
        waUrl && (
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-9 inline-flex items-center gap-3 rounded-md bg-[#25D366] px-7 py-3.5 font-sans text-sm font-medium uppercase tracking-[0.08em] text-white transition-all hover:brightness-110"
            aria-label="Falar diretamente pelo WhatsApp da Clínica Rim"
          >
            {/* WhatsApp icon (SVG inline para evitar dependência de lib de ícones) */}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
            </svg>
            Falar pelo WhatsApp
          </a>
        )
      }

      {/* Dados de contato */}
      <div class="mt-10 space-y-5 border-t border-white/10 pt-10">
        <div class="flex items-start gap-3.5">
          <svg
            class="mt-0.5 size-4 shrink-0 text-azure-300"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <p class="font-sans text-sm leading-relaxed text-azure-100">{clinic.address.full}</p>
        </div>
        <div class="flex items-start gap-3.5">
          <svg
            class="mt-0.5 size-4 shrink-0 text-azure-300"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 5a2 2 0 0 1 2-2h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 12l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 5Z" />
          </svg>
          <p class="font-sans text-sm text-azure-100">{clinic.phoneDisplay}</p>
        </div>
      </div>
    </div>

    {/* ── Coluna direita: formulário ── */}
    <div data-reveal="fade-left">
      <ContactForm client:visible whatsappNumber={clinic.whatsappNumber || undefined} />
    </div>
  </Container>
</Section>
