---
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { symptomGroups, symptomsIntro } from '@/data/symptoms';

/**
 * Seção "Quando procurar um Especialista?" — grid 3-colunas, fundo claro.
 *
 * Cada coluna representa uma especialidade com cor de acento própria.
 * Mantido como HTML puro (0 JS). Toda a lista de sintomas fica visível
 * (sem acordeão) para maximizar o valor de SEO e legibilidade.
 * ⚠️ CONTEÚDO VERBATIM — não alterar títulos, leads ou listas.
 */

const styles = [
  {
    stripe: 'bg-azure-400',
    badge: 'bg-azure-500/10 text-azure-300 border border-azure-500/30',
    dot: 'bg-azure-400',
  },
  {
    stripe: 'bg-gold-400',
    badge: 'bg-gold-500/10 text-gold-300 border border-gold-500/30',
    dot: 'bg-gold-400',
  },
  {
    stripe: 'bg-ink-400',
    badge: 'bg-white/5 text-ink-200 border border-white/15',
    dot: 'bg-ink-400',
  },
] as const;
---

<Section id="areas" labelledby="areas-heading" class="bg-ink-900">
  <Container>
    <div data-reveal="fade-up">
      <SectionHeading
        id="areas-heading"
        eyebrow="Áreas de Atendimento"
        title="Quando procurar um Especialista?"
        intro={symptomsIntro}
      />
    </div>

    <div data-reveal-stagger class="mx-auto mt-14 grid max-w-6xl gap-6 md:grid-cols-3">
      {
        symptomGroups.map((group, i) => {
          const s = styles[i];
          return (
            <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-ink-950/40 transition-colors hover:border-azure-500/30">
              {/* Faixa colorida no topo — identificador visual da especialidade */}
              <div class={`h-1 w-full ${s.stripe}`} aria-hidden="true"></div>

              <div class="p-8 pt-6">
                <span class={`inline-block rounded-md px-3 py-1 font-sans text-xs font-medium ${s.badge}`}>
                  {group.specialty}
                </span>

                <h3 class="mt-5 font-display text-xl font-medium text-white">{group.title}</h3>
                <p class="mt-2 font-sans text-sm leading-relaxed text-ink-300">{group.lead}</p>

                <ul class="mt-6 space-y-2.5" role="list">
                  {group.items.map((item) => (
                    <li class="flex items-start gap-3 font-sans text-sm leading-relaxed text-azure-100">
                      <span class={`mt-[0.42rem] size-1.5 shrink-0 rounded-full ${s.dot}`} aria-hidden="true"></span>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })
      }
    </div>
  </Container>
</Section>
