---
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import HeroKidney from '@/components/react/HeroKidney.tsx';
import { SPECIALTIES } from '@/data/specialties';
import { buildWhatsappUrl } from '@/lib/utils/whatsapp';

/**
 * Seção 1 — Primeira Dobra.
 * v5 "Abismo Clínico + rim de partículas": canvas quase-preto com glows aqua,
 * copy à esquerda e, à direita, a assinatura visual da marca — um rim formado
 * por milhares de partículas WebGL (HeroKidney) que se formam na entrada,
 * flutuam e giram reagindo ao mouse/scroll (inspirado no hero da Dala).
 * Parallax dos orbs/cartão e tilt do painel via script inline; o rim é uma
 * ilha React (client:load, acima da dobra).
 * Headline/subheadline e checklist revisados por feedback do cliente.
 */
const waUrl = buildWhatsappUrl('Olá! Gostaria de agendar uma consulta na Clínica Rim.');
const ctaHref = waUrl ?? '#contato';
const ctaTarget = waUrl ? '_blank' : undefined;
const ctaRel = waUrl ? 'noopener noreferrer' : undefined;

const trustItems = [
  'Especialistas titulados (RQE)',
  'Consultas individualizadas',
  'Cuidado integrado',
  'Foco no paciente',
];
---

<section
  id="inicio"
  class="bg-hero-mesh relative flex min-h-[100svh] scroll-mt-20 items-center overflow-hidden"
>
  {/* Grade pontilhada sutil no canto superior esquerdo */}
  <div
    class="bg-dot-grid pointer-events-none absolute top-0 left-0 h-72 w-72 [mask-image:radial-gradient(closest-side,black,transparent)] opacity-40"
    aria-hidden="true"
  >
  </div>

  {/* ── Par de rins em tela cheia (grande), deslocado para a direita ── */}
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <HeroKidney client:load class="h-full w-full" />
  </div>

  {/* Degradê escuro à esquerda: garante leitura do texto sem "colar" nos rins */}
  <div
    class="pointer-events-none absolute inset-y-0 left-0 z-[1] hidden w-3/5 bg-gradient-to-r from-[#030b0c] via-[#030b0c]/85 to-transparent lg:block"
    aria-hidden="true"
  >
  </div>

  <Container class="relative z-10 w-full py-24 sm:py-28 lg:py-32">
    <div class="max-w-2xl">
      {/* ── Coluna principal ── */}
      <div data-hero-content class="min-w-0 text-center lg:text-left">
        <p
          data-reveal="fade-down"
          data-parallax="0.12"
          class="border-azure-400/30 text-azure-200 mb-6 inline-flex items-center gap-2 rounded-md border bg-white/5 px-4 py-1.5 font-sans text-xs font-medium tracking-[0.12em] uppercase backdrop-blur-sm"
        >
          <span class="bg-azure-400 size-1.5 rounded-full" aria-hidden="true"></span>
          Londrina, Paraná
        </p>

        <h1
          data-reveal="fade-up"
          class="font-display text-5xl leading-none font-medium tracking-tight text-balance text-white sm:text-6xl lg:text-7xl"
        >
          Clínica Rim Saúde renal com cuidado integral
        </h1>

        <p
          data-reveal="fade-up"
          data-reveal-delay="100"
          class="text-azure-100 mx-auto mt-8 max-w-xl font-sans text-lg leading-relaxed text-pretty lg:mx-0"
        >
          Unimos ciência, escuta atenta e compromisso com o seu bem-estar. Aqui você encontra
          soluções coordenadas em Nefrologia, Endocrinologia e Urologia.
        </p>

        <div
          data-reveal="fade-up"
          data-reveal-delay="200"
          class="mt-9 flex flex-col items-center gap-4 sm:flex-row sm:justify-center lg:justify-start"
        >
          <Button href={ctaHref} target={ctaTarget} rel={ctaRel} size="lg">
            Agendar uma consulta
          </Button>
          <a
            href="/#especialistas"
            class="text-azure-300 inline-flex h-13 items-center gap-2 rounded-md px-6 font-sans text-sm font-medium transition-colors hover:text-white"
          >
            Conhecer especialistas
            <svg
              class="size-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </a>
        </div>

        {/* Indicadores de confiança */}
        <ul
          data-reveal="fade-in"
          data-reveal-delay="300"
          class="mt-10 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 border-t border-white/10 pt-7 lg:justify-start"
          aria-label="Diferenciais da clínica"
        >
          {
            trustItems.map((item) => (
              <li class="text-azure-100 flex items-center gap-2 font-sans text-sm font-medium">
                <span
                  class="bg-azure-500/15 text-azure-300 flex size-5 items-center justify-center rounded-full"
                  aria-hidden="true"
                >
                  <svg
                    class="size-3"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      {/* Pills de especialidade */}
      <ul
        data-reveal="fade-in"
        data-reveal-delay="400"
        class="mt-8 flex flex-wrap items-center justify-center gap-2.5 lg:justify-start"
        aria-label="Especialidades"
      >
        {
          SPECIALTIES.map((s) => (
            <li class="border-azure-500/30 text-azure-200 rounded-md border bg-white/5 px-4 py-1.5 font-sans text-sm font-medium backdrop-blur-sm">
              {s}
            </li>
          ))
        }
      </ul>
    </div>
  </Container>

  {/* Indicador de scroll — "mouse" com bolinha descendo em loop */}
  <div
    data-scroll-cue
    class="pointer-events-none absolute bottom-14 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 lg:flex"
    aria-hidden="true"
  >
    <span class="flex h-8 w-5 items-start justify-center rounded-full border border-white/25 p-1">
      <span
        class="hero-scroll-dot bg-azure-300 size-1 rounded-full"
        style="animation: hero-scroll-dot 1.6s ease-in-out infinite;"></span>
    </span>
  </div>

  {
    /* Interatividade: parallax por mouse/scroll + tilt 3D do painel de fotos.
      Zero dependência; respeita prefers-reduced-motion. */
  }
  <script is:inline>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var section = document.getElementById('inicio');
      if (!section) return;

      var layers = Array.prototype.slice.call(section.querySelectorAll('[data-parallax]'));
      var tilt = section.querySelector('[data-tilt]');
      var mouseX = 0,
        mouseY = 0; // -1..1 relativo ao centro da seção
      var scrollY = 0;
      var raf = null;

      function apply() {
        raf = null;
        layers.forEach(function (el) {
          var depth = parseFloat(el.getAttribute('data-parallax')) || 0;
          var tx = mouseX * depth * 26;
          var ty = mouseY * depth * 26 + scrollY * depth * 0.12;
          el.style.transform = 'translate3d(' + tx.toFixed(1) + 'px,' + ty.toFixed(1) + 'px,0)';
        });
        if (tilt) {
          var rx = (mouseY * -5).toFixed(2);
          var ry = (mouseX * 6).toFixed(2);
          tilt.style.transform =
            'perspective(1000px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg)';
        }
      }

      function schedule() {
        if (!raf) raf = requestAnimationFrame(apply);
      }

      section.addEventListener('mousemove', function (e) {
        var r = section.getBoundingClientRect();
        mouseX = ((e.clientX - r.left) / r.width - 0.5) * 2;
        mouseY = ((e.clientY - r.top) / r.height - 0.5) * 2;
        schedule();
      });
      section.addEventListener('mouseleave', function () {
        mouseX = 0;
        mouseY = 0;
        schedule();
      });
      window.addEventListener(
        'scroll',
        function () {
          scrollY = window.scrollY || 0;
          schedule();
        },
        { passive: true },
      );
    })();
  </script>
</section>
