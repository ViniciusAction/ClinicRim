---
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import { SPECIALTIES } from '@/data/specialties';
import { clinic } from '@/data/clinic';
import { buildWhatsappUrl } from '@/lib/utils/whatsapp';

/**
 * Seção 1 — Primeira Dobra.
 *
 * v6 "Retroiluminado". O rim de partículas em WebGL foi REMOVIDO a pedido do
 * cliente (nada de órgão ilustrado) e a foto da recepção ao fundo também foi
 * reprovada — então a atmosfera é feita só de LUZ E AR, como o letreiro de
 * acrílico retroiluminado da recepção:
 *
 *  1. ondulações concêntricas (assinatura da nefrologia) respirando ao fundo;
 *  2. aurora — dois campos de luz aqua derivando em tempos diferentes;
 *  3. partículas — poeira luminosa FINA subindo devagar (canvas puro, sem lib);
 *  4. grade pontilhada + grão fino, para textura e contra o banding;
 *  5. faixa de vidro rente à base com os diferenciais, em 4 colunas iguais.
 *
 * Toda a informação foi preservada (local, nome, promessa, especialidades,
 * CTAs, diferenciais) e ganhou endereço/telefone — sinais de clínica de
 * verdade. O parallax do mouse vive no elemento PAI dos campos de luz e a
 * animação no filho, para os dois transforms não brigarem. Tudo respeita
 * prefers-reduced-motion.
 */
const waUrl = buildWhatsappUrl('Olá! Gostaria de agendar uma consulta na Clínica Rim.');
const ctaHref = waUrl ?? '#contato';
const ctaTarget = waUrl ? '_blank' : undefined;
const ctaRel = waUrl ? 'noopener noreferrer' : undefined;

/**
 * Diferenciais da clínica. Cada um com seu próprio ícone — quatro "checks"
 * iguais achatavam a leitura; ícones distintos fazem a caixa parecer uma
 * lista de fato, não uma decoração repetida.
 */
const trustItems = [
  {
    label: 'Especialistas titulados (RQE)',
    // Escudo com check — titulação/credencial
    paths: ['M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z', 'm9 12 2 2 4-4'],
  },
  {
    label: 'Consultas individualizadas',
    // Relógio — tempo dedicado a cada paciente
    paths: ['M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z', 'M12 7v5l3 2'],
  },
  {
    label: 'Cuidado integrado',
    // Nós conectados — as três especialidades conversando
    paths: [
      'M6 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
      'M18 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
      'M12 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
      'M7.6 7.4 11 15m5.4-7.6L13 15M8.5 5.5h7',
    ],
  },
  {
    label: 'Foco no paciente',
    // Coração — cuidado humanizado
    paths: ['M12 20s-7-4.6-7-9.4A3.9 3.9 0 0 1 12 8a3.9 3.9 0 0 1 7 2.6C19 15.4 12 20 12 20Z'],
  },
];
---

<section
  id="inicio"
  class="bg-hero-mesh relative flex min-h-[100svh] scroll-mt-20 flex-col overflow-hidden"
>
  {/* ── Camada 1: ondulações concêntricas — assinatura da nefrologia ── */}
  <div
    class="pointer-events-none absolute inset-0 z-[1] grid place-items-center"
    aria-hidden="true"
  >
    <div
      class="bg-ripples hero-ripple aspect-square w-[140vh] min-w-[900px] [mask-image:radial-gradient(closest-side,black,transparent_78%)] opacity-[0.06]"
      style="animation: hero-ripple-breathe 16s ease-in-out infinite;"
    >
    </div>
  </div>

  {/* ── Camada 2: aurora — luz viva, sem ilustração ── */}
  <div class="pointer-events-none absolute inset-0 z-[2] overflow-hidden" aria-hidden="true">
    <div data-parallax="0.16" class="absolute -top-1/4 right-0 left-0 mx-auto h-[42rem] w-[42rem]">
      <div
        class="hero-aurora bg-azure-500/25 h-full w-full rounded-full blur-[150px]"
        style="animation: hero-aurora-a 18s ease-in-out infinite;"
      >
      </div>
    </div>
    <div data-parallax="0.09" class="absolute -bottom-1/3 left-[8%] h-[34rem] w-[34rem]">
      <div
        class="hero-aurora bg-azure-700/30 h-full w-full rounded-full blur-[160px]"
        style="animation: hero-aurora-b 23s ease-in-out infinite;"
      >
      </div>
    </div>
    <div data-parallax="0.13" class="absolute top-1/4 right-[4%] h-[28rem] w-[28rem]">
      <div
        class="hero-aurora bg-azure-400/15 h-full w-full rounded-full blur-[170px]"
        style="animation: hero-aurora-b 27s ease-in-out infinite 2s;"
      >
      </div>
    </div>
  </div>

  {/* ── Camada 3: partículas (poeira luminosa) — canvas puro, zero dependência ── */}
  <canvas
    data-hero-particles
    class="pointer-events-none absolute inset-0 z-[3] h-full w-full"
    aria-hidden="true"></canvas>

  {/* ── Camada 4: grade pontilhada nos cantos opostos + grão fino ── */}
  <div
    class="bg-dot-grid pointer-events-none absolute top-0 left-0 z-[4] h-72 w-72 [mask-image:radial-gradient(closest-side,black,transparent)] opacity-30"
    aria-hidden="true"
  >
  </div>
  <div
    class="bg-dot-grid pointer-events-none absolute right-0 bottom-0 z-[4] h-72 w-72 [mask-image:radial-gradient(closest-side,black,transparent)] opacity-20"
    aria-hidden="true"
  >
  </div>
  <div
    class="bg-noise pointer-events-none absolute inset-0 z-[5] opacity-[0.035]"
    aria-hidden="true"
  >
  </div>

  {/* ── Conteúdo ── */}
  <div class="relative z-10 flex flex-1 items-center">
    <Container class="w-full py-24 sm:py-28 lg:py-32">
      <div class="mx-auto max-w-4xl text-center">
        <p
          data-reveal="fade-down"
          class="border-azure-400/25 text-azure-200 mb-8 inline-flex items-center gap-2.5 rounded-full border bg-white/[0.04] px-4 py-1.5 font-sans text-[11px] font-medium tracking-[0.18em] uppercase backdrop-blur-sm"
        >
          <span class="relative flex size-1.5" aria-hidden="true">
            <span
              class="bg-azure-400/60 absolute inline-flex h-full w-full animate-ping rounded-full"
            ></span>
            <span class="bg-azure-400 relative inline-flex size-1.5 rounded-full"></span>
          </span>
          Clínica médica em Londrina, Paraná
        </p>

        <h1
          data-reveal="fade-up"
          class="font-display mx-auto max-w-3xl tracking-tight text-balance text-white"
        >
          <span
            class="text-brand-shimmer block text-5xl leading-[0.95] font-medium sm:text-6xl lg:text-7xl"
          >
            Clínica Rim
          </span>
          <span
            class="mt-4 block text-2xl leading-tight font-normal text-white/90 sm:text-3xl lg:text-[2.5rem]"
          >
            Saúde renal com cuidado integral
          </span>
        </h1>

        {/* Especialidades como linha editorial dividida — mais assinatura que "pills" */}
        <ul
          data-reveal="fade-in"
          data-reveal-delay="100"
          class="divide-azure-400/25 text-azure-300 mt-8 inline-flex divide-x font-sans text-[11px] font-medium tracking-[0.2em] uppercase"
          aria-label="Especialidades"
        >
          {SPECIALTIES.map((s) => <li class="px-4 first:pl-0 last:pr-0 sm:px-6">{s}</li>)}
        </ul>

        <p
          data-reveal="fade-up"
          data-reveal-delay="150"
          class="text-azure-100/85 mx-auto mt-8 max-w-xl font-sans text-base leading-relaxed text-pretty sm:text-lg"
        >
          Unimos ciência, escuta atenta e compromisso com o seu bem-estar. Aqui você encontra
          soluções coordenadas em Nefrologia, Endocrinologia e Urologia.
        </p>

        <div
          data-reveal="fade-up"
          data-reveal-delay="250"
          class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center"
        >
          <Button href={ctaHref} target={ctaTarget} rel={ctaRel} size="lg">
            Agendar uma consulta
          </Button>
          <a
            href="/#especialistas"
            class="group text-azure-300 inline-flex h-13 items-center gap-2 rounded-md px-6 font-sans text-sm font-medium transition-colors hover:text-white"
          >
            Conhecer especialistas
            <svg
              class="size-4 transition-transform duration-200 group-hover:translate-x-1"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </a>
        </div>

        {
          /* ── Caixa de vidro com os diferenciais ──
          Antes era uma faixa colada na base da seção, longe do conteúdo. Agora
          é um painel dentro da composição: fio de luz no topo (a assinatura do
          letreiro retroiluminado), células divididas por hairlines e um leve
          realce no hover. */
        }
        <div data-reveal="fade-up" data-reveal-delay="300" class="mt-14">
          <div
            class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.035] shadow-[0_20px_60px_-30px_rgba(0,0,0,0.8)] backdrop-blur-md"
          >
            {/* Fio de luz no topo, apagando nas pontas */}
            <span
              class="via-azure-300/50 absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent to-transparent"
              aria-hidden="true"></span>

            <ul
              class="grid grid-cols-1 divide-y divide-white/[0.07] sm:grid-cols-2 sm:divide-x lg:grid-cols-4 lg:divide-y-0"
              aria-label="Diferenciais da clínica"
            >
              {
                trustItems.map((item) => (
                  <li class="group flex items-center gap-3 px-5 py-5 transition-colors duration-200 hover:bg-white/[0.03] sm:flex-col sm:gap-3 sm:px-4 sm:py-6 sm:text-center">
                    <span
                      class="border-azure-400/20 bg-azure-500/10 text-azure-300 group-hover:border-azure-400/40 group-hover:text-azure-200 flex size-9 shrink-0 items-center justify-center rounded-lg border transition-colors duration-200"
                      aria-hidden="true"
                    >
                      <svg
                        class="size-[18px]"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        {item.paths.map((d) => (
                          <path d={d} />
                        ))}
                      </svg>
                    </span>
                    <span class="text-azure-100 font-sans text-sm leading-snug font-medium text-balance">
                      {item.label}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        {/* Endereço e telefone reais — sinal de consultório, não de landing genérica */}
        <div
          data-reveal="fade-in"
          data-reveal-delay="400"
          class="text-azure-200/55 mt-9 flex flex-col items-center justify-center gap-x-6 gap-y-2 font-sans text-xs sm:flex-row"
        >
          <p class="flex items-center gap-2">
            <svg
              class="text-azure-400/70 size-3.5 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            {clinic.address.full}
          </p>
          <span class="hidden h-3 w-px bg-white/15 sm:block" aria-hidden="true"></span>
          <a
            href={`tel:+55${clinic.phoneDisplay.replace(/\D/g, '')}`}
            class="flex items-center gap-2 transition-colors hover:text-white"
          >
            <svg
              class="text-azure-400/70 size-3.5 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M3 5a2 2 0 0 1 2-2h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 12l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 5Z"
              ></path>
            </svg>
            {clinic.phoneDisplay}
          </a>
        </div>
      </div>
    </Container>
  </div>

  {/* Indicador de scroll — "mouse" com bolinha descendo em loop */}
  <div
    data-scroll-cue
    class="pointer-events-none relative z-10 hidden justify-center pb-6 lg:flex"
    aria-hidden="true"
  >
    <span class="flex h-8 w-5 items-start justify-center rounded-full border border-white/20 p-1">
      <span
        class="hero-scroll-dot bg-azure-300 size-1 rounded-full"
        style="animation: hero-scroll-dot 1.6s ease-in-out infinite;"></span>
    </span>
  </div>

  {
    /* Interatividade 1 — parallax sutil dos campos de luz por mouse/scroll.
      Zero dependência; respeita prefers-reduced-motion. */
  }
  <script is:inline>
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var section = document.getElementById('inicio');
      if (!section) return;

      var layers = Array.prototype.slice.call(section.querySelectorAll('[data-parallax]'));
      if (!layers.length) return;

      var mouseX = 0,
        mouseY = 0; // -1..1 relativo ao centro da seção
      var scrollY = 0;
      var raf = null;

      function apply() {
        raf = null;
        layers.forEach(function (el) {
          var depth = parseFloat(el.getAttribute('data-parallax')) || 0;
          var tx = mouseX * depth * 30;
          var ty = mouseY * depth * 30 + scrollY * depth * 0.14;
          el.style.transform = 'translate3d(' + tx.toFixed(1) + 'px,' + ty.toFixed(1) + 'px,0)';
        });
      }

      function schedule() {
        if (!raf) raf = requestAnimationFrame(apply);
      }

      section.addEventListener('mousemove', function (e) {
        var r = section.getBoundingClientRect();
        mouseX = ((e.clientX - r.left) / r.width - 0.5) * 2;
        mouseY = ((e.clientY - r.top) / r.height - 0.5) * 2;
        schedule();
      });
      section.addEventListener('mouseleave', function () {
        mouseX = 0;
        mouseY = 0;
        schedule();
      });
      window.addEventListener(
        'scroll',
        function () {
          scrollY = window.scrollY || 0;
          schedule();
        },
        { passive: true },
      );
    })();
  </script>

  {
    /* Interatividade 2 — partículas de luz subindo devagar.
      Canvas 2D puro (zero dependência, ~2kB). Os brilhos são um sprite
      pré-renderizado e reaproveitado, então o custo por quadro é só drawImage.
      Pausa quando a seção sai da tela; com prefers-reduced-motion desenha um
      único quadro estático. */
  }
  <script is:inline>
    (function () {
      var canvas = document.querySelector('[data-hero-particles]');
      if (!canvas || !canvas.getContext) return;

      var ctx = canvas.getContext('2d');
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var w = 0,
        h = 0,
        parts = [],
        raf = null,
        visible = true;
      var pointer = { x: -9999, y: -9999 };

      // Sprites de brilho (aqua e branco): um radial-gradient desenhado uma vez.
      function makeSprite(rgb) {
        var s = document.createElement('canvas');
        var size = 64;
        s.width = s.height = size;
        var c = s.getContext('2d');
        var g = c.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
        // Núcleo fechado + halo curto: evita o aspecto "estourado" de bolha.
        g.addColorStop(0, 'rgba(' + rgb + ',1)');
        g.addColorStop(0.12, 'rgba(' + rgb + ',0.7)');
        g.addColorStop(0.4, 'rgba(' + rgb + ',0.14)');
        g.addColorStop(1, 'rgba(' + rgb + ',0)');
        c.fillStyle = g;
        c.fillRect(0, 0, size, size);
        return s;
      }
      var sprites = [
        makeSprite('130,207,221'), // azure-300
        makeSprite('72,178,199'), // azure-400
        makeSprite('255,255,255'), // faísca branca
      ];

      function seed() {
        // Poeira fina: muitos pontos pequenos em vez de poucos "bolhões".
        // ~1 partícula por 9k px², limitada nos dois extremos.
        var count = Math.round(Math.min(190, Math.max(45, (w * h) / 9000)));
        parts = [];
        for (var i = 0; i < count; i++) {
          parts.push({
            x: Math.random() * w,
            y: Math.random() * h,
            r: 0.3 + Math.random() * 0.85,
            vx: (Math.random() - 0.5) * 0.09,
            vy: -(0.04 + Math.random() * 0.2),
            a: 0.14 + Math.random() * 0.3,
            tw: Math.random() * Math.PI * 2,
            tws: 0.005 + Math.random() * 0.013,
            sp: sprites[Math.random() < 0.1 ? 2 : Math.random() < 0.5 ? 0 : 1],
          });
        }
      }

      function resize() {
        var r = canvas.getBoundingClientRect();
        if (!r.width || !r.height) return;
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = r.width;
        h = r.height;
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        seed();
        if (reduce) draw(false);
      }

      function draw(animate) {
        ctx.clearRect(0, 0, w, h);
        for (var i = 0; i < parts.length; i++) {
          var p = parts[i];

          if (animate) {
            p.x += p.vx;
            p.y += p.vy;
            p.tw += p.tws;

            // Desvio suave ao redor do cursor — a nuvem "respeita" o mouse.
            var dx = p.x - pointer.x,
              dy = p.y - pointer.y;
            var d2 = dx * dx + dy * dy;
            if (d2 < 14400) {
              var f = (1 - Math.sqrt(d2) / 120) * 0.6;
              p.x += dx * 0.012 * f;
              p.y += dy * 0.012 * f;
            }

            // Reciclagem nas bordas (entra por baixo de novo).
            if (p.y < -20) {
              p.y = h + 20;
              p.x = Math.random() * w;
            }
            if (p.x < -20) p.x = w + 20;
            else if (p.x > w + 20) p.x = -20;
          }

          var alpha = p.a * (0.65 + 0.35 * Math.sin(p.tw));
          // O sprite é núcleo + halo curto; ×5 mantém o ponto entre 1,5 e 6px.
          var size = p.r * 5;
          ctx.globalAlpha = alpha;
          ctx.drawImage(p.sp, p.x - size / 2, p.y - size / 2, size, size);
        }
        ctx.globalAlpha = 1;
      }

      function frame() {
        raf = null;
        draw(true);
        if (visible) raf = requestAnimationFrame(frame);
      }

      function start() {
        if (reduce || raf) return;
        raf = requestAnimationFrame(frame);
      }
      function stop() {
        if (raf) cancelAnimationFrame(raf);
        raf = null;
      }

      window.addEventListener('resize', resize, { passive: true });
      document.addEventListener('mousemove', function (e) {
        var r = canvas.getBoundingClientRect();
        pointer.x = e.clientX - r.left;
        pointer.y = e.clientY - r.top;
      });
      document.addEventListener('mouseleave', function () {
        pointer.x = pointer.y = -9999;
      });

      resize();

      if (!reduce) {
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(
            function (entries) {
              visible = entries[0].isIntersecting;
              if (visible) start();
              else stop();
            },
            { threshold: 0 },
          ).observe(canvas);
        } else {
          start();
        }
      }
    })();
  </script>
</section>
