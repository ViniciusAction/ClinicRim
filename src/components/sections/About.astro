---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

/**
 * Seção 2 — "Por que escolher a Clínica Rim?" (Sobre / Diferenciais).
 *
 * Visual revamp: uma faixa dupla (marquee) de fotos reais da clínica rolando
 * em sentidos opostos, ocupando a largura toda — mostra bastante ambiente sem
 * ocupar espaço vertical demais. Abaixo, os diferenciais em grade de cards.
 * ⚠️ CONTEÚDO (títulos/descrições) VERBATIM.
 */
const differentials = [
  {
    title: 'Localização Central',
    description:
      'Acesso facilitado e conveniência para suas consultas, exames e rotina de cuidados no coração da cidade.',
  },
  {
    title: '3 Especialidades Integradas',
    description:
      'Nefrologia, Endocrinologia e Urologia atuando em perfeita sintonia para tratar e prevenir disfunções metabólicas, renais e do trato urinário.',
  },
  {
    title: 'Foco no Paciente',
    description:
      'Sem pressa. Valorizamos o tempo dedicado a ouvir sua história, entender seu contexto e construir decisões médicas compartilhadas.',
  },
  {
    title: 'Consulta Humanizada',
    description:
      'Nossa missão é oferecer um acolhimento com profundidade. Respeitamos a sua singularidade, integrando ciência de alta qualidade com sensibilidade.',
  },
];

// Fotos da clínica para o marquee.
const clinicModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/clinica/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
function pick(nums: number[]): ImageMetadata[] {
  return nums
    .map((n) => {
      const id = String(n).padStart(3, '0');
      const entry = Object.entries(clinicModules).find(([p]) => p.includes(`clinica-${id}.`));
      return entry?.[1]?.default;
    })
    .filter((x): x is ImageMetadata => Boolean(x));
}
const row1 = pick([3, 1, 40, 5, 4, 14, 50, 60]);
const row2 = pick([70, 80, 90, 100, 110, 2, 42, 120]);
---

<Section id="sobre" labelledby="sobre-heading" class="overflow-hidden bg-ink-900">
  <Container>
    <div data-reveal="fade-up">
      <SectionHeading
        id="sobre-heading"
        eyebrow="Sobre a Clínica"
        title="Por que escolher a Clínica Rim?"
        intro="Nossa prática médica nasce do equilíbrio entre excelência técnica e atendimento individualizado. Queremos diminuir a fragmentação da medicina atual, oferecendo um espaço focado no diálogo interprofissional e na real necessidade de cada paciente."
      />
    </div>
  </Container>

  {/* ── Marquee de fotos da clínica (largura total, dois sentidos) ── */}
  <div class="mt-14 flex flex-col gap-5" data-reveal="fade-up" data-reveal-delay="100">
    <div class="marquee-row overflow-hidden">
      <div class="marquee-track flex gap-5" style="animation-duration: 65s;">
        {
          [...row1, ...row1].map((photo, i) => (
            <div class="relative h-48 w-72 shrink-0 overflow-hidden rounded-2xl border border-white/10 sm:h-56 sm:w-80">
              <Image
                src={photo}
                alt={i < row1.length ? 'Ambiente da Clínica Rim' : ''}
                width={640}
                class="h-full w-full object-cover"
              />
            </div>
          ))
        }
      </div>
    </div>
    <div class="marquee-row overflow-hidden">
      <div class="marquee-track flex gap-5" style="animation-duration: 80s; animation-direction: reverse;">
        {
          [...row2, ...row2].map((photo) => (
            <div class="relative h-48 w-72 shrink-0 overflow-hidden rounded-2xl border border-white/10 sm:h-56 sm:w-80">
              <Image src={photo} alt="" width={640} class="h-full w-full object-cover" />
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {/* ── Diferenciais em grade ── */}
  <Container>
    <ul class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {
        differentials.map((item) => (
          <li class="rounded-2xl border border-white/10 bg-ink-950/40 p-7 transition-colors hover:border-azure-500/30">
            <span
              class="flex size-10 items-center justify-center rounded-md bg-azure-500/15 text-azure-300"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
            </span>
            <h3 class="mt-5 font-display text-lg font-medium text-white">{item.title}</h3>
            <p class="mt-2 font-sans text-sm leading-relaxed text-azure-100">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
