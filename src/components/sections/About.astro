---
import { Image } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import aboutPhoto from '@/assets/photos/about.jpg';

/**
 * Seção 2 — Sobre a Clínica / Diferenciais. Estática (0 JS).
 *
 * ⚠️ CONTEÚDO VERBATIM. Os diferenciais vêm no formato "Título: descrição".
 * Interpretação de UX: renderizo o título como cabeçalho do card e a descrição
 * como parágrafo (o ":" vira hierarquia visual). As PALAVRAS são idênticas ao
 * original. Se preferir o ":" literal inline, é uma troca de uma linha.
 *
 * Imagem: PLACEHOLDER (mockup de layout) — ver nota de imagens no rodapé do projeto.
 */
const differentials = [
  {
    title: 'Localização Central',
    description:
      'Acesso facilitado e conveniência para suas consultas, exames e rotina de cuidados no coração da cidade.',
  },
  {
    title: '3 Especialidades Integradas',
    description:
      'Nefrologia, Endocrinologia e Urologia atuando em perfeita sintonia para tratar e prevenir disfunções metabólicas, renais e do trato urinário.',
  },
  {
    title: 'Foco no Paciente',
    description:
      'Sem pressa. Valorizamos o tempo dedicado a ouvir sua história, entender seu contexto e construir decisões médicas compartilhadas.',
  },
  {
    title: 'Consulta Humanizada',
    description:
      'Nossa missão é oferecer um acolhimento com profundidade. Respeitamos a sua singularidade, integrando ciência de alta qualidade com sensibilidade.',
  },
];
---

<Section id="sobre" labelledby="sobre-heading" class="bg-white">
  <Container class="grid items-center gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div data-reveal="fade-right" class="relative">
      <div class="relative aspect-[4/5] overflow-hidden rounded-3xl">
        <Image
          src={aboutPhoto}
          alt=""
          width={700}
          height={875}
          class="h-full w-full object-cover"
        />
        <div class="duotone-navy absolute inset-0"></div>
      </div>
      <div
        class="absolute -bottom-6 -left-6 hidden rounded-2xl border border-azure-100 bg-white px-6 py-4 shadow-xl shadow-ink-900/10 sm:block"
      >
        <p class="font-display text-3xl font-semibold text-azure-700">3</p>
        <p class="font-sans text-xs tracking-wide text-ink-500 uppercase">Especialidades Integradas</p>
      </div>
    </div>

    <div data-reveal="fade-left">
      <SectionHeading
        id="sobre-heading"
        eyebrow="Sobre a Clínica"
        title="Por que escolher a Clínica Rim?"
        intro="Nossa prática médica nasce do equilíbrio entre excelência técnica e atendimento individualizado. Queremos diminuir a fragmentação da medicina atual, oferecendo um espaço focado no diálogo interprofissional e na real necessidade de cada paciente."
        align="left"
        class="max-w-none"
      />

      <ul class="mt-10 space-y-6" data-reveal-stagger>
        {
          differentials.map((item) => (
            <li class="flex items-start gap-4 border-b border-ink-100 pb-6 last:border-b-0 last:pb-0">
              <span
                class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-full bg-azure-50 text-azure-700"
                aria-hidden="true"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </span>
              <div>
                <h3 class="font-display text-xl font-semibold text-ink-900">{item.title}</h3>
                <p class="mt-1.5 font-sans text-ink-600">{item.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</Section>
