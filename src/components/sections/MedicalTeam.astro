---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Section from '@/components/ui/Section.astro';
import DoctorsCarousel, { type CarouselDoctor } from '@/components/react/DoctorsCarousel.tsx';
import { doctors } from '@/data/doctors';
import { buildWhatsappUrl } from '@/lib/utils/whatsapp';

/**
 * Seção 3 — Corpo Clínico.
 * Carrossel em destaque (estilo "Our team" da Dala): foto grande central,
 * nome/especialidade ao lado, setas para navegar. Fotos reais dos médicos.
 */
const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/doctors/*.{jpg,jpeg,png,webp}',
  { eager: true },
);

const items: CarouselDoctor[] = await Promise.all(
  doctors.map(async (d) => {
    const entry = Object.entries(photoModules).find(([path]) => path.includes(`/${d.photoId}.`));
    const img = entry?.[1]?.default;
    const optimized = img ? await getImage({ src: img, width: 720, format: 'webp' }) : null;
    const wa = buildWhatsappUrl(`Olá! Gostaria de agendar uma consulta com ${d.name}.`);
    return {
      id: d.id,
      name: d.name,
      role: d.role,
      specialty: d.specialty,
      crm: d.crm,
      rqe: d.rqe,
      miniBio: d.miniBio,
      photo: optimized?.src ?? null,
      photoW: optimized?.attributes.width ?? 720,
      photoH: optimized?.attributes.height ?? 900,
      wa: wa ?? null,
    };
  }),
);
---

<Section id="especialistas" labelledby="especialistas-heading" class="overflow-hidden bg-ink-950">
  <div data-reveal="fade-up">
    <DoctorsCarousel
      client:visible
      eyebrow="Corpo Clínico"
      title="Nossos Especialistas"
      intro="Conheça os especialistas por trás do cuidado integrado e personalizado da Clínica Rim."
      doctors={items}
    />
  </div>
</Section>
