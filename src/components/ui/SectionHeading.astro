---
import { cn } from '@/lib/utils/cn';

/**
 * Cabeçalho de seção reutilizável (eyebrow + título + intro).
 * `eyebrow` vira um selo-pílula aqua — assinatura visual do tema clean,
 * reforçando hierarquia sem poluir.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
  /** Usar em fundos escuros (hero navy) para inverter as cores. */
  inverted?: boolean;
}

const {
  id,
  eyebrow,
  title,
  intro,
  align = 'center',
  as = 'h2',
  class: className,
  inverted = false,
} = Astro.props;
const Heading = as;
const alignment = align === 'center' ? 'mx-auto text-center' : 'text-left';
const eyebrowJustify = align === 'center' ? 'justify-center' : 'justify-start';
---

<div class={cn('max-w-2xl', alignment, className)}>
  {
    eyebrow && (
      <p class={cn('mb-5 flex items-center', eyebrowJustify)}>
        <span
          class="inline-flex items-center gap-2 rounded-md border border-azure-400/30 bg-azure-400/10 px-3.5 py-1.5 font-sans text-[11px] font-medium tracking-[0.12em] text-azure-200 uppercase"
        >
          <span class="size-1.5 rounded-full bg-azure-300" aria-hidden="true" />
          {eyebrow}
        </span>
      </p>
    )
  }
  <Heading
    id={id}
    class={cn(
      'text-balance font-display text-3xl leading-none font-medium tracking-tight text-white sm:text-4xl lg:text-[2.6rem]',
    )}
  >
    {title}
  </Heading>
  {
    intro && (
      <p class="mt-5 text-pretty font-sans text-lg leading-relaxed text-azure-100">
        {intro}
      </p>
    )
  }
</div>
