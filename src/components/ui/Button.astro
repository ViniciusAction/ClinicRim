---
import { cn } from '@/lib/utils/cn';

/**
 * Botão polimórfico: renderiza <a> quando há `href`, senão <button>.
 * `primary` (aqua profundo) é o CTA da marca — funciona tanto nos fundos
 * claros quanto na seção escura de contato.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  id?: string;
  disabled?: boolean;
  target?: string;
  rel?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className,
  disabled = false,
  target,
  rel,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-md font-sans font-medium uppercase tracking-[0.08em] transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50';

const variants = {
  primary:
    'bg-brand-glow text-white hover:brightness-110 focus-visible:ring-azure-500',
  secondary:
    'bg-white/10 text-white hover:bg-white/15 focus-visible:ring-white/40',
  outline:
    'border border-white/20 bg-white/5 text-white hover:border-azure-400 hover:bg-white/10 focus-visible:ring-azure-400',
};

const sizes = {
  md: 'h-11 px-6 text-sm',
  lg: 'h-13 px-8 text-base',
};

const classes = cn(base, variants[variant], sizes[size], className);
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} {...rest}>
      <slot />
    </button>
  )
}
