---
import { cn } from '@/lib/utils/cn';

interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}

const { as = 'div', class: className } = Astro.props;
const Tag = as;
---

<Tag class={cn('mx-auto w-full max-w-[1440px] px-5 sm:px-8 lg:px-12 xl:px-16', className)}>
  <slot />
</Tag>
