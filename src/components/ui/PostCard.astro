---
import { Image } from 'astro:assets';
import type { BlogPost } from '@/lib/blog';
import { SPECIALTY_SLUGS } from '@/data/specialties';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const formattedDate = post.data.pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-ink-900 transition-colors duration-300">
  <a href={`/blog/${post.id}/`} class="block aspect-[16/9] w-full overflow-hidden bg-ink-800">
    <Image
      src={post.data.cover}
      alt={post.data.coverAlt}
      width={640}
      height={360}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </a>
  <div class="flex flex-1 flex-col p-8">
    <div class="flex items-center gap-3 font-sans text-xs text-ink-300">
      <a
        href={`/blog/especialidade/${SPECIALTY_SLUGS[post.data.specialty]}/`}
        class="rounded-md bg-azure-500/10 px-2.5 py-1 font-medium text-azure-300 hover:bg-azure-500/20"
      >
        {post.data.specialty}
      </a>
      <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
    </div>
    <h3 class="mt-3 font-display text-lg font-medium text-white">
      <a href={`/blog/${post.id}/`} class="hover:text-azure-300">
        {post.data.title}
      </a>
    </h3>
    <p class="mt-2 flex-1 font-sans text-sm leading-relaxed text-azure-100">{post.data.description}</p>
  </div>
</article>
