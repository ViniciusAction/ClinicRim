---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { cn } from '@/lib/utils/cn';
import horizontal from '@/assets/logos/clinica-rim-horizontal.jpg';
import classica from '@/assets/logos/clinica-rim-classica.png';
import monoHorizontal from '@/assets/logos/clinica-rim-mono-horizontal-trim.png';
import monoStacked from '@/assets/logos/clinica-rim-mono-stacked-trim.png';

/**
 * Ponto ÚNICO de renderização da logo.
 *
 * ⚠️ Sobre os arquivos de arte (importante para não repetir o bug do header):
 *  - `horizontal` (.jpg) e `classica` (.png) têm o FUNDO AZUL EMBUTIDO na
 *    imagem. Sobre o header/rodapé quase-preto elas aparecem como um retângulo
 *    azulado visível — foi o que o cliente reprovou. Use-as apenas onde um
 *    bloco retangular é aceitável (ex.: imagem de OG/compartilhamento).
 *  - `mono-horizontal` / `mono-stacked` são as ÚNICAS realmente transparentes
 *    (arte preta sobre alfa). São as indicadas para a interface. Sobre fundo
 *    escuro, combine com `onDark` (inverte a arte para branco).
 *
 * Os arquivos mono usados aqui são as versões `-trim` (recortadas, sem a
 * moldura 16:9 do original) — a logo passa a ocupar de fato a altura pedida.
 *
 * Variantes:
 *  - mono-horizontal / mono-stacked .. transparentes (padrão da interface)
 *  - horizontal / classica ........... com fundo próprio (OG / usos gráficos)
 */
type Variant = 'horizontal' | 'classica' | 'mono-horizontal' | 'mono-stacked';

interface Props {
  variant?: Variant;
  class?: string;
  alt?: string;
  eager?: boolean;
  width?: number;
  /** Inverte a arte preta para branco — para uso sobre fundo escuro. */
  onDark?: boolean;
}

const {
  variant = 'mono-horizontal',
  class: className,
  alt = 'Clínica Rim',
  eager = false,
  width = 220,
  onDark = false,
} = Astro.props;

const sources: Record<Variant, ImageMetadata> = {
  horizontal,
  classica,
  'mono-horizontal': monoHorizontal,
  'mono-stacked': monoStacked,
};

const isMono = variant.startsWith('mono-');
---

<Image
  src={sources[variant]}
  alt={alt}
  width={width}
  densities={[1, 2]}
  loading={eager ? 'eager' : 'lazy'}
  class={cn(onDark && isMono && 'invert', className)}
/>
