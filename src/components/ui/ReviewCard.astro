---
import type { Review } from '@/data/reviews';

interface Props {
  review: Review;
}

const { review } = Astro.props;
const stars = Array.from({ length: 5 }, (_, i) => i < Math.round(review.rating));

// Função simples para pegar as iniciais (ex: "João Pedro" -> "JP")
const getInitials = (name: string) => {
  const parts = name.trim().split(' ');
  if (parts.length >= 2) {
    return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
  }
  return name.substring(0, 2).toUpperCase();
};

const initials = getInitials(review.author);
---

<figure class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-ink-100 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-ink-900/5 break-inside-avoid">
  {/* Aspas decorativas no fundo */}
  <svg 
    class="absolute right-6 top-6 size-16 text-azure-50 opacity-50 transition-transform duration-300 group-hover:scale-110" 
    fill="currentColor" 
    viewBox="0 0 24 24" 
    aria-hidden="true"
  >
    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
  </svg>

  <div class="relative flex items-center gap-4">
    {/* Avatar com Gradiente */}
    <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-azure-100 to-azure-200 text-azure-800 shadow-inner">
      <span class="font-display text-sm font-bold tracking-wider">{initials}</span>
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex items-center justify-between gap-2">
        <div class="truncate font-sans text-base font-bold text-ink-900" title={review.author}>
          {review.author}
        </div>
        {/* Selo Verificado do Google */}
        <div class="flex shrink-0 items-center gap-1 rounded-full border border-ink-100 bg-ink-50 px-2 py-1" title="Avaliação verificada pelo Google">
          <svg viewBox="0 0 24 24" class="size-3" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span class="font-sans text-[10px] font-bold tracking-wide text-ink-500 uppercase">Verificado</span>
        </div>
      </div>
      <div class="mt-1 flex items-center gap-2">
        <div class="flex gap-0.5" role="img" aria-label={`Nota ${review.rating} de 5`}>
          {stars.map((filled) => (
            <svg
              class={filled ? 'size-3.5 text-gold-400' : 'size-3.5 text-ink-100'}
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L10 14.77l-5.2 2.73.99-5.79L1.58 7.62l5.82-.85L10 1.5z" />
            </svg>
          ))}
        </div>
        {review.date && (
          <span class="font-sans text-xs text-ink-400">• {review.date}</span>
        )}
      </div>
    </div>
  </div>

  <blockquote class="relative mt-6 flex-1 font-sans text-[15px] leading-relaxed text-ink-600">
    <p class="text-pretty">"{review.text}"</p>
  </blockquote>
</figure>
